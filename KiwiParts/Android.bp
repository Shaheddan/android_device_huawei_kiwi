android_app {
    name: "KiwiParts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: false,
    privileged: false,
    static_libs: [
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibSettingsTheme",
    ],
}
