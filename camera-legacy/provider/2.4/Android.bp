// kiwi: LineageOS's legacy HIDL camera provider 2.4, carried in the device tree.
// WHY: removed from hardware/lineage/interfaces in LineageOS 22.2 together with the device
// 1.0 next door (see ../../device/1.0/Android.bp). The stock
// android.hardware.camera.provider@2.4-service from hardware/interfaces loads this library
// exactly as it did on LineageOS 21. Copied from lineage-21.0 (239c373) plus kiwi's
// String8::c_str() fix.
cc_library_shared {
    name: "android.hardware.camera.provider@2.4-impl-legacy",
    defaults: ["hidl_defaults"],
    proprietary: true,
    relative_install_path: "hw",
    srcs: ["CameraProvider.cpp"],
    shared_libs: [
        "libhidlbase",
        "libutils",
        "libcutils",
        "android.hardware.camera.device@1.0",
        "camera.device@1.0-impl-legacy",
        "android.hardware.camera.provider@2.4",
        "android.hardware.camera.common@1.0",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@3.0",
        "android.hardware.graphics.mapper@4.0",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
        "liblog",
        "libhardware",
        "libcamera_metadata"
    ],
    static_libs: [
        "android.hardware.camera.common@1.0-helper"
    ]
}
