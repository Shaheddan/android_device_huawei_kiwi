permissive hal_gatekeeper_default;
permissive hal_bluetooth_default;
permissive hal_audio_default;
permissive hal_camera_default;
permissive hal_power_default;
permissive hal_memtrack_default;
permissive hal_usb_default;
permissive hal_vibrator_default;
permissive hal_drm_default;
permissive hal_keymaster_default;
permissive hal_graphics_allocator_default;
